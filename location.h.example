// Copy to location.h (gitignored) and set the point you want weather for.
// Decimal degrees: north and east are positive, south and west negative.
// Only the first 4 decimals (~11 m) are sent to the weather API.
#ifndef LOCATION_H
#define LOCATION_H

const float LATITUDE  = 00.0000;
const float LONGITUDE = 00.0000;

#endif
